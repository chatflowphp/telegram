{
    "name": "chatflowphp/telegram",
    "description": "Telegram adapter for the ChatFlow conversational runtime.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/chatflowphp/telegram",
    "authors": [
        {
            "name": "Alex",
            "email": "webnarmin@gmail.com",
            "role": "maintainer",
            "homepage": "https://github.com/webnarmin"
        }
    ],
    "support": {
        "issues": "https://github.com/chatflowphp/telegram/issues",
        "source": "https://github.com/chatflowphp/telegram"
    },
    "require": {
        "php": "^8.2",
        "chatflowphp/core": "^1.0",
        "irazasyed/telegram-bot-sdk": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "ChatFlow\\Telegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChatFlow\\Telegram\\Examples\\MiniShop\\": "examples/MiniShop/",
            "ChatFlow\\Telegram\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml",
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ],
        "cs-fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "cs-check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
