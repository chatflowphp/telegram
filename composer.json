{
    "name": "chatflowphp/telegram",
    "description": "Telegram adapter for the ChatFlow conversational runtime.",
    "type": "library",
    "license": "MIT",
    "keywords": ["telegram", "bot", "chatbot", "state-machine", "scenes"],
    "homepage": "https://github.com/chatflowphp/telegram",
    "authors": [
        {
            "name": "Alex",
            "email": "webnarmin@gmail.com",
            "role": "maintainer",
            "homepage": "https://github.com/webnarmin"
        }
    ],
    "support": {
        "issues": "https://github.com/chatflowphp/telegram/issues",
        "source": "https://github.com/chatflowphp/telegram"
    },
    "require": {
        "php": "^8.2",
        "chatflowphp/core": "^2.0",
        "irazasyed/telegram-bot-sdk": "^3.16",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "vlucas/phpdotenv": "Load bot tokens from a .env file in the example entrypoints."
    },
    "autoload": {
        "psr-4": {
            "ChatFlow\\Telegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChatFlow\\Telegram\\Examples\\": "examples/",
            "ChatFlow\\Telegram\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
