# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Backward-compatible local alias accepted by examples/MiniShop/run.php.
# Prefer TELEGRAM_BOT_TOKEN in new projects.
TELEGRAM_TOKEN=

# --- ChatFlow runtime logs ---
CHATFLOW_RUNTIME_LOG=storage/minishop/runtime.jsonl

# --- Application ---
APP_DEBUG=false
APP_LOCALE=en

# --- Logging ---
LOG_DRIVER=file
LOG_PATH=storage/logs/chatflow-telegram.log
LOG_LEVEL=100
LOG_FORMAT=text
